#!/bin/sh
set -eu
# Opt-in: a normal desktop without WeChat/configuration starts no read service.
test -f /config/woc-read/config.json || exit 0
woc_read_temp=$(mktemp /config/woc-read/.server.XXXXXX)
trap 'rm -f "$woc_read_temp"' EXIT
cat /opt/woc-read/server.py > "$woc_read_temp"
chmod 700 "$woc_read_temp"
chown abc:abc "$woc_read_temp"
mv -f "$woc_read_temp" /config/woc-read/server.py
for woc_read_module in ui_service.py wechat_ui.py; do
  if [ -f "/opt/woc-read/$woc_read_module" ]; then
    cp "/opt/woc-read/$woc_read_module" "/config/woc-read/$woc_read_module"
    chmod 600 "/config/woc-read/$woc_read_module"
    chown abc:abc "/config/woc-read/$woc_read_module"
  fi
done
mkdir -p /run/service/woc-read
cat > /run/service/woc-read/run <<'RUN'
#!/bin/sh
umask 077
export WX_IMAGE_KVCOMM_DIR="${WX_IMAGE_KVCOMM_DIR:-/config/woc-read/private/image-kvcomm}"
exec s6-setuidgid abc python3 /config/woc-read/server.py --config /config/woc-read/config.json
RUN
chmod 755 /run/service/woc-read/run
s6-svscanctl -a /run/service
